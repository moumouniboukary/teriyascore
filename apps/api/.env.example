DATABASE_URL="postgresql://teriyascore:teriyascore@localhost:5433/teriyascore?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="teriyascore-dev-secret-change-me-min-32-chars!!"
PORT=3001
HOST=0.0.0.0
# * = téléphone sur le LAN (PWA). En prod, fixer l'origine.
CORS_ORIGIN="*"
NODE_ENV="development"
# SMS — sans config : console + code affiché dans l'app (mode test)
#
# Option A — Twilio (recommandé)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_auth_token"
# TWILIO_FROM="+221XXXXXXXXX"   # numéro Twilio (ou Messaging Service SID: MGxxx)
#
# Option B — gateway HTTP générique
# SMS_GATEWAY_URL="https://sms-provider.example/send"
# SMS_API_KEY="..."

# Worker async (npm run worker) — activé sur Render
USE_JOB_QUEUE=1

# Admin agents (header X-Admin-Key)
# ADMIN_API_KEY="clé-admin-longue"

# Mobile Money (stubs si non configuré)
# ORANGE_MM_URL="https://api.orange.example/mm"
# ORANGE_MM_API_KEY="..."
# ORANGE_MM_TOKEN_URL="https://api.orange.example/oauth/token"
# ORANGE_MM_CLIENT_ID=""
# ORANGE_MM_CLIENT_SECRET=""
# MOOV_MM_URL="https://api.moov.example/mm"
# MOOV_MM_API_KEY="..."

# Push FCM (Firebase Cloud Messaging — Legacy server key)
# FCM_SERVER_KEY=""

# White-label / branding
# BRAND_APP_NAME="TeriyaScore"
# BRAND_PRIMARY_COLOR="#2DB88A"
# BRAND_SECONDARY_COLOR="#5DCAA5"
# BRAND_LOGO_URL=
# BRAND_SUPPORT_PHONE=
# PARTNER_BRAND_JSON={"appName":"IMF Partner","primaryColor":"#1A6B4A"}

# Ingestion KoboCollect (agents terrain / webhook KoboToolbox)
# KOBO_API_KEY="clé-partagée-longue-et-secrète"

# Partenaires IMF (portail /imf)
# PARTNER_API_KEY=

# NeoScore ML (solvabilité) — docker compose up -d neoscore-ml
# Laisser vide = heuristique TypeScript uniquement.
SCORING_ML_URL=http://localhost:8000
SCORING_ML_TIMEOUT_MS=8000

# Suivi d'erreurs (optionnel)
# SENTRY_DSN=""
# ALERT_WEBHOOK_URL=
